---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CorrectionForm from '../../components/CorrectionForm.astro';
import Promesse from '../../components/Promesse.astro';
import RankRow from '../../components/RankRow.astro';
import TexteEditorial from '../../components/TexteEditorial.astro';
import WhyRanking from '../../components/WhyRanking.astro';
import Icon from '../../components/Icon.astro';
import { textes as lireTextes } from '../../lib/textes-store';
import { appellationsById, dataset, producerPath, producersById, regionsById } from '../../lib/data';
import { SITE_URL, formatScore, safeWebsite } from '../../lib/site';
import { wineTone } from '../../lib/ui';
import type { Appellation } from '../../lib/types';
export function getStaticPaths() { return dataset.appellations.map(appellation => ({ params: { slug: appellation.slug }, props: { appellation } })); }
interface Props { appellation: Appellation }
const { appellation } = Astro.props;
const path = `/appellations/${appellation.slug}/`;
const textes = await lireTextes('textes-appellations');
const texte = textes.find(entry => entry.data.slug === appellation.slug);
const regions = (appellation.regions ?? []).map(id => regionsById.get(id)).filter(r => r !== undefined);
const structuredData = { '@context': 'https://schema.org', '@graph': appellation.classements.map(group => ({
  '@type': 'ItemList', '@id': new URL(`${path}#${group.ancre}`, SITE_URL).href,
  name: `${appellation.nom} (${group.couleur})`, numberOfItems: group.vignerons.length,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: [...group.vignerons].sort((a,b) => a.rang-b.rang).map(entry => {
    const producer = producersById.get(entry.producer_id);
    if (!producer) throw new Error(`Vigneron absent : ${entry.producer_id}`);
    return { '@type': 'ListItem', position: entry.rang, name: producer.nom, url: new URL(producerPath(producer), SITE_URL).href };
  }),
})) };
const inao = safeWebsite(appellation.inao_url);
const crumbs = [...(regions[0] ? [{ name: regions[0].nom, path: `/regions/${regions[0].slug}/` }] : []), { name: appellation.nom, path }];
const groups = appellation.classements.map(group => {
  const entries = [...group.vignerons].sort((a, b) => a.rang - b.rang);
  const medalsOf = (producerId: string) => producersById.get(producerId)!.medailles.filter(m => m.appellation_id === appellation.id && m.couleur === group.couleur);
  const shown = entries.map(e => formatScore(e.score));
  return { group, entries, medalsOf, tie: shown.some((v, i) => shown.indexOf(v) !== i) };
});
const competitionIds = [...new Set(groups.flatMap(g => g.entries.flatMap(e => g.medalsOf(e.producer_id).map(m => m.concours_id))))];
const colors = appellation.classements.map(g => g.couleur.toLowerCase());
const colorText = colors.length > 1 ? `${colors.slice(0, -1).join(', ')} et ${colors[colors.length - 1]}` : colors[0];
// Appellations voisines : les autres appellations de la même région, les plus disputées d'abord.
const voisines = [...new Set(regions.flatMap(r => r.appellations))].filter(id => id !== appellation.id)
  .map(id => appellationsById.get(id)).filter(a => a !== undefined)
  .map(a => ({ a, n: Math.max(0, ...a.classements.map(g => g.total_vignerons_medailles)) }))
  .sort((x, y) => y.n - x.n || x.a.nom.localeCompare(y.a.nom, 'fr')).slice(0, 9);
---
<BaseLayout bleed title={`Meilleurs vignerons de ${appellation.nom} selon les concours`} description={`Les vignerons médaillés recensés de ${appellation.nom}, classés par couleur selon les résultats de concours. Comparez, appelez ou allez-y.`} searchable structuredData={structuredData} breadcrumbs={crumbs}>
  <header class="container page-head">
    <p class="eyebrow">Appellation{regions.length > 0 && <> · {regions.map((r, i) => <>{i > 0 && ', '}<a href={`/regions/${r.slug}/`}>{r.nom}</a></>)}</>}</p>
    <h1>{appellation.nom}</h1>
    <Promesse>Les meilleurs vignerons médaillés recensés, pas tous les producteurs, classés en {colorText} selon {competitionIds.length} concours.</Promesse>
  </header>

  {appellation.classements.length > 1 && <nav class="color-nav" aria-label="Couleurs classées">
    <div class="container color-nav__inner"><span class="color-nav__label" aria-hidden="true">Couleur</span><ul>{appellation.classements.map(group => <li><a href={`#${group.ancre}`} data-tone={wineTone(group.couleur)}><span class="swatch" aria-hidden="true"></span>{group.couleur} · {group.total_vignerons_medailles}<Icon name="down" /></a></li>)}</ul></div>
  </nav>}

  <div class="container">
    {groups.map(({ group, entries, medalsOf }) => <section id={group.ancre} class="ranking" data-tone={wineTone(group.couleur)} aria-labelledby={`titre-${group.ancre}`}>
      <header class="ranking__head">
        <h2 class="ranking__title" id={`titre-${group.ancre}`}><span class="swatch" aria-hidden="true"></span>{group.couleur}<span class="sr-only"> : {appellation.nom}</span></h2>
        <p class="ranking__sub">{entries.length > 1 ? <>Les <strong>{entries.length} premiers</strong></> : <strong>Le premier</strong>} sur {group.total_vignerons_medailles} vignerons médaillés</p>
      </header>
      <ol class="rank-list">{entries.map(entry => <li><RankRow producer={producersById.get(entry.producer_id)!} rank={entry.rang} total={group.total_vignerons_medailles} score={entry.score} medals={medalsOf(entry.producer_id)} /></li>)}</ol>
    </section>)}

    <WhyRanking competitionIds={competitionIds} tie={groups.some(g => g.tie)} />

    {(texte || inao) && <section class="section about" aria-labelledby="a-propos">
      <h2 id="a-propos">L’appellation {appellation.nom}</h2>
      {texte && <TexteEditorial texte={texte} />}
      {inao && <p><a class="text-link" href={inao}>Cahier des charges sur le site de l’INAO<Icon name="external" /></a></p>}
    </section>}

    {regions.length === 0 && <p class="note section">Aucune région rattachée dans les données.</p>}
    {voisines.length > 0 && <section class="section" aria-labelledby="voisines">
      <h2 id="voisines">Appellations voisines</h2>
      <ul class="link-list link-list--cols">{voisines.map(({ a }) => <li><a href={`/appellations/${a.slug}/`}>{a.nom}<Icon name="arrow" /></a></li>)}</ul>
      {regions.map(r => <p><a class="text-link" href={`/regions/${r.slug}/`}>Toutes les appellations de la région {r.nom}<Icon name="arrow" /></a></p>)}
    </section>}
    <p class="note section">Les couleurs viennent des résultats recensés. Elles ne constituent pas une liste réglementaire.</p>
    <CorrectionForm page={path} />
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TexteEditorial from '../../components/TexteEditorial.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import { textes as lireTextes } from '../../lib/textes-store';
import { dataset } from '../../lib/data';
import { bareme, baremes, campaignPath, competitionKey, competitionPath } from '../../lib/concours';
import { formatInt } from '../../lib/ui';
import type { Competition } from '../../lib/types';

export function getStaticPaths() {
  return dataset.competitions.map(competition => ({
    params: { slug: competitionKey(competition.id) }, props: { competition },
  }));
}
interface Props { competition: Competition }
const { competition } = Astro.props;
const slug = competitionKey(competition.id);
const path = competitionPath(competition);
const textes = await lireTextes('textes-concours');
const texte = textes.find(entry => entry.data.slug === slug);
const scale = baremes(dataset).get(competition.id) ?? bareme(competition, []);
const campaigns = [...competition.campagnes_absorbees].sort((a, b) => b - a);
const count = (annee: number) => dataset.producers.reduce((total, producer) =>
  total + producer.medailles.filter(medal => medal.concours_id === competition.id && medal.annee === annee).length, 0);
---
<BaseLayout title={`${competition.nom} : palmarès, barème et campagnes`} description={`${competition.nom} : poids, barème, campagnes absorbées et palmarès annuels des vignerons classés dans Laureati.`} breadcrumbs={[{ name: 'Concours', path: '/concours/' }, { name: competition.nom, path }]}>
  <div class="container"><header class="page-head">
    <p class="eyebrow"><a href="/concours/">Concours</a></p>
    <h1>{competition.nom}</h1>
    <p class="lede">Un concours suivi par Laureati pour classer les vignerons par appellation et par couleur.</p>
    <dl class="stats stats--3">
      <div><dt>poids</dt><dd>{competition.poids}</dd></div>
      <div><dt>campagnes absorbées</dt><dd>{campaigns.length}</dd></div>
      <div><dt>dernière campagne</dt><dd>{competition.derniere_campagne ?? 'aucune'}</dd></div>
    </dl>
    <p><a class="text-link" href={competition.url}>Palmarès officiel du concours<Icon name="external" /></a></p>
  </header></div>

  {texte && <div class="container"><TexteEditorial texte={texte} /></div>}

  <div class="container">
    <section class="section" aria-labelledby="bareme">
      <SectionHead eyebrow="Barème" title="Les niveaux de médaille" id="bareme" />
      <p>Le meilleur niveau vaut 3 points, le suivant 2, le dernier 1. Un « Or » ne vaut donc pas 3 points dans tous les concours.</p>
      <ul class="bareme">{scale.map(level => <li><strong>{level.label}</strong><span>{level.points} point{level.points > 1 ? 's' : ''}</span></li>)}</ul>
      <p class="note">Le calcul complet, la fenêtre de trois campagnes et la décote de récence sont sur <a href="/methodologie/">la méthodologie</a>.</p>
    </section>

    <section class="section" aria-labelledby="campagnes">
      <SectionHead eyebrow="Fraîcheur" title="Campagnes absorbées et palmarès annuels" id="campagnes" />
      <p>Laureati utilise les {campaigns.length} dernières campagnes absorbées de ce concours : {campaigns.join(', ')}. La plus récente pèse le plus.</p>
      <p class="note">Chaque palmarès annuel ne liste que les vignerons du corpus publié. Le palmarès complet reste sur <a href={competition.url}>le site officiel</a>.</p>
      <ul class="link-list link-list--cols">{campaigns.map(annee => <li>
        <a href={campaignPath(competition, annee)}>{annee}<span class="note">{formatInt(count(annee))} médailles</span><Icon name="arrow" /></a>
      </li>)}</ul>
    </section>
  </div>
</BaseLayout>
